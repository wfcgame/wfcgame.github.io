---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import VideoPreview from '../components/VideoPreview.astro';
import Footer from '../components/Footer.astro';
import { PROFILE, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const projects = (await getCollection('projects'))
  .sort((a, b) => Number(b.data.experience) - Number(a.data.experience) || Number(a.data.concept) - Number(b.data.concept) || a.data.order - b.data.order);
const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
const date = (value: Date) => new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', day: 'numeric' }).format(value);
---
<!doctype html>
<html lang="en">
  <head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} /></head>
  <body>
    <Header />
    <main>
      <section class="hero shell" id="top">
        <div class="hero-copy">
          <div class="hero-kicker"><span class="live-dot"></span> DEVELOPER PORTFOLIO <span class="kicker-line"></span> 2026</div>
          <p class="hello">Hello, I'm</p>
          <h1>Wong<span>fengchen.</span></h1>
          <p class="hero-lead">I build games, explore ideas, and share what I learn.</p>
          <p class="hero-description">Previously contributed to MU Origin, King Fish Dragon, and Sniper Revenge. Explore my game development experience and personal projects.</p>
          <div class="hero-actions">
            <a class="button button-primary" href="#projects">Explore my work <span>↗</span></a>
            <a class="button button-outline" href={`mailto:${PROFILE.email}`}>Get in touch <span>↗</span></a>
          </div>
          <div class="hero-social"><span>FIND ME ON</span><a href={PROFILE.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href="/blog/">Writing ↗</a></div>
        </div>
        <div class="hero-display" aria-hidden="true">
          <div class="display-grid"></div>
          <div class="display-orbit orbit-one"></div><div class="display-orbit orbit-two"></div>
          <div class="display-monogram">W<span>.</span></div>
          <div class="display-label top-label"><span class="label-dot"></span> AVAILABLE ONLINE</div>
          <div class="display-label bottom-label"><span>01 / PORTFOLIO</span><span>BUILD · LEARN · SHARE</span></div>
          <div class="display-code">&lt;developer&gt;<br />&nbsp;&nbsp;always learning<br />&lt;/developer&gt;</div>
        </div>
      </section>

      <div class="signal-strip"><div class="shell strip-inner"><span>DESIGN & DEVELOPMENT</span><span class="strip-star">✳</span><span>EXPERIMENTS</span><span class="strip-star">✳</span><span>IDEAS IN PROGRESS</span><span class="strip-star">✳</span><span>WONGFENGCHEN</span></div></div>

      <section class="about section shell" id="about">
        <div class="section-side"><span class="eyebrow">01 / ABOUT ME</span><div class="side-rule"></div></div>
        <div class="about-main">
          <h2>From game worlds to the web.<span> Always building.</span></h2>
          <p>My previous experience includes development contributions to MU Origin, King Fish Dragon, and Sniper Revenge. Today, I bring that curiosity to personal projects, game concepts, and the web—and document what I learn along the way.</p>
          <div class="toolkit"><span>TOOLS USED ON THIS SITE</span><div><span>Astro</span><span>TypeScript</span><span>Markdown</span></div></div>
        </div>
      </section>

      <section class="work section" id="projects">
        <div class="shell">
          <div class="section-heading"><div><span class="eyebrow">02 / SELECTED WORK</span><h2>Games & selected projects<span class="accent-dot">.</span></h2></div><a class="text-link" href={PROFILE.github} target="_blank" rel="noopener noreferrer">View GitHub ↗</a></div>
          <p class="section-intro">Previous game development contributions, personal projects, and experiments. Select a game preview to watch gameplay.</p>
          <div class:list={["own-grid", { "single-project": projects.length === 1 }]}>
            {projects.map((project, index) => (
              <article class:list={["own-card", { "experience-card": project.data.experience }]}>
                {project.data.videoId ? <VideoPreview videoId={project.data.videoId} image={project.data.image} title={project.data.title} /> : <div class="own-image">{project.data.image ? <img src={project.data.image} alt={`${project.data.title} preview`} loading="lazy" /> : <span class="image-fallback">{project.data.title.slice(0, 1)}</span>}</div>}
                <div class="own-content"><div class="card-meta"><span class="card-number">PROJECT / {String(index + 1).padStart(2, '0')}</span>{project.data.experience && <span class="experience-badge">DEVELOPMENT CONTRIBUTOR</span>}{project.data.concept && <span class="concept-badge">FICTIONAL CONCEPT</span>}</div><h3>{project.data.title}</h3>{project.data.author && project.data.author !== PROFILE.name && <span class="creator">BY {project.data.author}</span>}<p>{project.data.description}</p><div class="tag-list">{project.data.tags.map((tag) => <span>{tag}</span>)}</div>{project.data.href ? <a class="project-cta" href={project.data.href} target={project.data.href.startsWith('http') ? '_blank' : undefined} rel={project.data.href.startsWith('http') ? 'noopener noreferrer' : undefined}>{project.data.videoId ? "Watch on YouTube ↗" : "View project ↗"}</a> : project.data.article ? <a class="project-cta" href={project.data.article}>Read concept notes ↗</a> : null}{project.data.videoCredit && <p class="video-credit">Gameplay reference: {project.data.videoTitle}<br />Video & thumbnail: {project.data.videoCredit} / YouTube</p>}</div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="writing section shell" id="writing">
        <div class="section-heading"><div><span class="eyebrow">03 / JOURNAL</span><h2>Ideas in writing<span class="accent-dot">.</span></h2></div><a class="text-link" href="/blog/">All articles ↗</a></div>
        <p class="section-intro">Notes from building, problem solving, and learning in public.</p>
        <div class="article-list">{posts.map((post, index) => <a class="article-item" href={`/blog/${post.id}/`}><span class="article-index">{String(index + 1).padStart(2, '0')}</span><div><h3>{post.data.title}</h3><p>{post.data.description}</p></div><time datetime={post.data.pubDate.toISOString()}>{date(post.data.pubDate)}</time><span class="article-arrow">↗</span></a>)}</div>
      </section>


      <section class="contact section" id="contact"><div class="shell contact-inner"><div><span class="eyebrow">04 / CONTACT</span><h2>Have something<br />in mind<span>?</span></h2><p>Whether you want to collaborate or just talk about an idea, I'd love to hear from you.</p></div><div class="contact-actions"><a class="contact-mail" href={`mailto:${PROFILE.email}`}>{PROFILE.email} <span>↗</span></a><a class="contact-github" href={PROFILE.github} target="_blank" rel="noopener noreferrer">Or find me on GitHub ↗</a></div></div></section>
    </main>
    <Footer />
  </body>
</html>
<style>
.hero{min-height:710px;display:grid;grid-template-columns:1.08fr .92fr;gap:48px;align-items:center;padding-top:72px;padding-bottom:88px}.hero-kicker{display:flex;align-items:center;gap:11px;color:var(--accent);font-size:11px;font-weight:700;letter-spacing:.16em}.live-dot{width:7px;height:7px;background:var(--accent);border-radius:50%;box-shadow:0 0 0 4px #b8eb7020}.kicker-line{height:1px;width:26px;background:#66834e}.hello{color:#b7c1b9;font-size:22px;margin:45px 0 3px}.hero h1{font-size:clamp(50px,5.3vw,80px);line-height:1.03;letter-spacing:-.085em;margin:0 0 28px;word-break:break-word}.hero h1 span{color:var(--accent);display:inline-block}.hero-lead{font-size:clamp(24px,2.6vw,33px);font-weight:700;line-height:1.3;max-width:620px;letter-spacing:-.04em;margin:0 0 16px}.hero-description{color:var(--muted);max-width:530px;margin:0 0 30px}.hero-actions{display:flex;gap:12px;flex-wrap:wrap}.button{min-height:48px;padding:11px 17px;border-radius:8px;font-weight:700;font-size:14px;display:inline-flex;gap:35px;align-items:center;justify-content:space-between}.button-primary{background:var(--accent);color:#132017}.button-primary:hover{background:#d3f59b;color:#132017}.button-outline{border:1px solid #5a675c;color:var(--ink)}.hero-social{display:flex;align-items:center;gap:24px;margin-top:60px;font-size:13px}.hero-social>span{font-size:10px;letter-spacing:.16em;color:#78847e;font-weight:700}.hero-social a{color:#d2dad2}.hero-display{height:480px;border:1px solid #34423b;border-radius:20px;position:relative;overflow:hidden;background:radial-gradient(circle at 50% 48%,#254336 0%,#15261e 36%,#111b18 73%);box-shadow:0 28px 70px #0005}.display-grid{position:absolute;inset:0;background-image:linear-gradient(#ffffff09 1px,transparent 1px),linear-gradient(90deg,#ffffff09 1px,transparent 1px);background-size:29px 29px;mask-image:linear-gradient(transparent,#000 22%,#000 75%,transparent)}.display-orbit{position:absolute;border:1px solid #9ecf8138;border-radius:50%;left:50%;top:49%;transform:translate(-50%,-50%)}.orbit-one{width:340px;height:340px}.orbit-two{width:470px;height:470px}.display-monogram{position:absolute;left:50%;top:45%;transform:translate(-50%,-50%);font-size:clamp(175px,21vw,295px);font-weight:700;line-height:1;letter-spacing:-.16em;color:#c8f29d;text-shadow:0 0 100px #a3ee7540}.display-monogram span{color:#ebf6dc}.display-label{position:absolute;font-family:monospace;font-size:10px;letter-spacing:.1em;color:#bed0bd}.top-label{left:25px;top:25px;display:flex;gap:9px;align-items:center}.label-dot{background:var(--accent);width:7px;height:7px;border-radius:50%}.bottom-label{left:25px;right:25px;bottom:22px;display:flex;justify-content:space-between;border-top:1px solid #ffffff22;padding-top:17px}.display-code{position:absolute;right:29px;top:80px;color:#bed7bc80;font-family:monospace;font-size:11px;line-height:1.5}.signal-strip{border-block:1px solid #2a3b2e;background:#17231b}.strip-inner{min-height:58px;display:flex;align-items:center;justify-content:space-between;gap:16px;color:#bbd6b0;font-size:11px;font-weight:700;letter-spacing:.16em}.strip-star{color:var(--accent);font-size:19px}.section{padding-block:105px}.about{display:grid;grid-template-columns:235px 1fr;gap:45px}.section-side{padding-top:10px}.side-rule{height:1px;background:var(--line);margin-top:20px;width:125px}.about-main h2{font-size:clamp(37px,5vw,62px);letter-spacing:-.065em;line-height:1.14;max-width:850px;margin:0 0 26px}.about-main h2 span{color:#8b978e}.about-main>p{color:var(--muted);font-size:18px;max-width:760px;margin:0 0 42px}.toolkit{border-top:1px solid var(--line);padding-top:27px;display:flex;justify-content:space-between;gap:25px;align-items:center}.toolkit>span{font-size:11px;color:#849087;letter-spacing:.13em;font-weight:700}.toolkit>div{display:flex;flex-wrap:wrap;gap:8px}.toolkit>div span{padding:8px 14px;border:1px solid #445343;border-radius:6px;color:#c9e2bc;font-size:13px}.work{background:#12191a;border-block:1px solid var(--line)}.accent-dot{color:var(--accent)}.own-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px}.own-grid.single-project{grid-template-columns:1fr}.single-project .own-card{display:grid;grid-template-columns:1.1fr .9fr}.single-project .own-image{height:100%;min-height:360px}.single-project .own-content{display:flex;flex-direction:column;justify-content:center}.own-card{display:block;background:#192220;border:1px solid #314036;border-radius:14px;overflow:hidden;transition:transform .2s,border-color .2s}.own-card:hover,.inspiration-card:hover{transform:translateY(-4px);border-color:#7f9d6b;color:inherit}.own-image{height:300px;background:#dce9df;overflow:hidden}.own-image img{width:100%;height:100%;object-fit:cover;display:block}.own-content{padding:29px}.card-number{font-size:10px;letter-spacing:.17em;color:var(--accent);font-weight:700}.own-content h3{font-size:29px;letter-spacing:-.05em;display:flex;justify-content:space-between;gap:15px;margin:10px 0 7px}.own-content h3 span{font-size:24px;color:var(--accent)}.own-content p{color:var(--muted);font-size:15px;margin:0 0 21px}.tag-list{display:flex;flex-wrap:wrap;gap:8px}.tag-list span{border:1px solid #46574a;border-radius:999px;padding:5px 11px;color:#c5d2c0;font-size:11px}.section-intro{color:var(--muted);font-size:16px;margin:-8px 0 37px}.article-list{border-top:1px solid var(--line)}.article-item{display:grid;grid-template-columns:60px 1fr 155px 25px;gap:20px;align-items:center;padding:27px 4px;border-bottom:1px solid var(--line)}.article-index{font-family:monospace;font-size:13px;color:var(--accent)}.article-item h3{font-size:23px;letter-spacing:-.04em;margin:0 0 4px}.article-item p{margin:0;color:var(--muted);font-size:14px}.article-item time{font-size:13px;color:var(--muted)}.article-arrow{color:var(--accent);font-size:21px}.inspiration{padding-top:20px}.inspiration-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.inspiration-card{display:block;border:1px solid var(--line);border-radius:12px;overflow:hidden;background:var(--paper);transition:transform .2s,border-color .2s}.inspiration-image{height:180px;overflow:hidden;background:#26352d}.inspiration-image img{width:100%;height:100%;object-fit:cover;display:block}.image-fallback{height:100%;display:grid;place-items:center;font-size:90px;color:var(--accent)}.inspiration-content{padding:19px 20px 24px}.creator{font-size:10px;color:var(--accent);font-weight:700;letter-spacing:.15em}.inspiration-content h3{font-size:20px;letter-spacing:-.04em;display:flex;justify-content:space-between;gap:10px;margin:8px 0}.inspiration-content h3 span{color:var(--accent)}.inspiration-content p{font-size:13px;color:var(--muted);margin:0}.contact{background:var(--accent);color:#142019;margin-top:70px;padding-block:90px}.contact .eyebrow{color:#365631}.contact-inner{display:flex;justify-content:space-between;align-items:end;gap:45px}.contact h2{font-size:clamp(52px,7vw,88px);letter-spacing:-.08em;line-height:1.02;margin:18px 0}.contact h2 span{color:#639355}.contact p{max-width:480px;margin:0;font-size:17px;color:#38523a}.contact-actions{display:flex;flex-direction:column;align-items:flex-start;gap:19px;padding-bottom:10px}.contact-mail{background:#142019;color:#e8f8d8;border-radius:8px;padding:15px 20px;display:flex;justify-content:space-between;gap:38px;font-weight:700;white-space:nowrap}.contact-mail:hover{color:#fff}.contact-github{color:#244329;font-size:14px;font-weight:700}@media(max-width:900px){.hero{grid-template-columns:minmax(0,1fr);min-height:auto;padding-block:70px}.hero-copy,.hero-display{min-width:0}.hero-display{max-width:650px;width:100%;height:390px}.about{grid-template-columns:1fr;gap:15px}.side-rule{display:none}.inspiration-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.contact-inner{align-items:flex-start;flex-direction:column}.strip-inner span:nth-last-child(-n+2){display:none}}@media(max-width:640px){.hero{padding-top:52px;gap:45px}.hero h1{font-size:clamp(43px,10.5vw,64px)}.hero-lead{font-size:24px}.hero-social{margin-top:39px}.hero-display{height:320px}.display-monogram{font-size:190px}.display-code{display:none}.strip-inner{font-size:9px}.strip-inner span:nth-last-child(-n+4){display:none}.section{padding-block:75px}.toolkit{align-items:flex-start;flex-direction:column}.own-grid,.inspiration-grid{grid-template-columns:1fr}.own-image{height:230px}.single-project .own-card{display:block}.single-project .own-image{height:230px;min-height:0}.article-item{grid-template-columns:36px 1fr 25px;gap:10px}.article-item time{grid-column:2;grid-row:2}.article-arrow{grid-column:3;grid-row:1}.contact{margin-top:30px}.contact-mail{white-space:normal;width:100%;gap:12px}.contact-actions{width:100%}}
.card-meta{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap}.concept-badge{font-size:10px;letter-spacing:.1em;font-weight:700;color:#f3d6a3;background:#5f4229;border:1px solid #967149;border-radius:999px;padding:4px 9px}.project-cta{display:inline-flex;align-items:center;gap:14px;margin-top:22px;color:var(--accent);font-size:13px;font-weight:700}.project-cta:hover{text-decoration:underline;text-underline-offset:4px}
.experience-card{border-color:#5a704a}.experience-badge{font-size:9px;letter-spacing:.08em;font-weight:700;color:var(--accent);border:1px solid #587345;background:#263a29;border-radius:999px;padding:4px 9px}.own-content .video-credit{font-size:11px;line-height:1.6;color:#97a69b;margin:18px 0 0;padding-top:14px;border-top:1px solid var(--line)}
</style>
